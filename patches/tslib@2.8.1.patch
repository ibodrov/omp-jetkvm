+// Patched for omp 18's extension graph loader (2026-08).
+//
+// omp's loader pulls this file into its rewrite graph and serves every module
+// through Bun onLoad hooks with forced-ESM semantics — no CommonJS interop.
+// The upstream `import tslib from '../tslib.js'` default-imports the CJS
+// build, which has no ESM default export, so the whole graph fails with
+// "Missing 'default' export in module '.../tslib/tslib.js'". Re-export the
+// pure-ESM build instead; the namespace object keeps default-import parity
+// with the CJS module.exports shape.
+import * as tslib from "../tslib.es6.mjs";
+
+export * from "../tslib.es6.mjs";
 export default tslib;
